{
  "version": 1,
  "routes": [
    { "event": "issues",       "action": "labeled", "label": "ready-for-ai", "route": "issue-loop" },
    { "event": "issues",       "action": "labeled", "label": "auto-release", "route": "auto-release-loop" },
    { "event": "pull_request", "action": "labeled", "label": "auto-merge",   "route": "merge-flow" },
    { "event": "pull_request", "action": "labeled", "label": "auto-rework",  "route": "rework-loop" }
  ]
}
